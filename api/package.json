{
  "name": "@forge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forge REST API — multi-user, team-based project management",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "drizzle-kit generate",
