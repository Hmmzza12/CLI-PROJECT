# ─────────────────────────────────────────────────────────────
# Forge API — environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database — local SQLite file (default), relative to the api/ directory.
DATABASE_URL=./forge.db

# Hosted DB (Turso / libSQL). When TURSO_DATABASE_URL is set it takes priority
# over DATABASE_URL and the app uses the libSQL driver (persistent, for hosting).
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT secrets — REQUIRED (the server refuses to start without them).
# Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string

# Token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Seed demo data (demo@forge.dev / password123) on boot — handy for hosted demos.
# SEED_ON_START=false

# Path to the built frontend to serve in production (defaults to ../frontend/dist).
# WEB_DIST=
